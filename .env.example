# 용도: Gemini 연결과 로컬 서버 제한에 필요한 환경변수 예시를 제공한다.
# Copy to .env at the repository root. Never put API keys in VITE_ variables.
LLM_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite
# Use an unbilled Google AI Studio Free Tier project. Availability/quota is account-specific.
# Free API mode is for synthetic demonstration text only.
LLM_TIMEOUT_SECONDS=45
MAX_INPUT_CHARS=10000
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Local single-process budget guard; counts requests including failures.
MAX_REQUESTS_PER_MINUTE=10
MAX_REQUESTS_PER_DAY=100
